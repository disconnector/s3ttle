<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  S3ttle.entitlements — App capabilities / permissions.

  WHAT THIS FILE DOES:
  Declares which Apple services the app is allowed to use. Each entitlement
  must also be enabled in the Apple Developer Portal (Certificates, IDs & Profiles).

  CURRENT ENTITLEMENTS:
  - Sign in with Apple: Required for our authentication flow.

  FUTURE ENTITLEMENTS (add as needed):
  - Push Notifications (aps-environment)
  - Associated Domains (for universal links / deep linking)
  - Keychain Sharing (if we need to share credentials across app extensions)
-->
<plist version="1.0">
<dict>
	<!-- Sign in with Apple capability -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
